# Local-only development configuration. Copy to .env and replace generated values.
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
WEB_ORIGIN=http://127.0.0.1:5173

# PostgreSQL development database (local Docker only; do not reuse in production).
POSTGRES_DB=pet_reception
POSTGRES_USER=pet_reception
POSTGRES_PASSWORD=pet_reception_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pet_reception:pet_reception_dev@127.0.0.1:5432/pet_reception
DATABASE_CONNECT_TIMEOUT_SECONDS=2

# Shared only between the local voice gateway and backend. Generate a random value.
VOICE_GATEWAY_SERVICE_TOKEN=GENERATE_A_RANDOM_SERVICE_TOKEN
DEMO_MERCHANT_ID=demo-grooming-001
# Optional project-relative or absolute path shared by backend and voice gateway.
# Startup fails if its merchant id does not match DEMO_MERCHANT_ID.
# MERCHANT_CONFIG_PATH=config/demo-merchant.json

# Qwen Audio Agent v1.11.0 / Qwen Audio 3.0 Realtime.
# Keep the real key only in .env; never put it in the browser or commit it.
DASHSCOPE_API_KEY=
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
QWEN_AUDIO_AGENT_AUTH_SECRET=GENERATE_A_RANDOM_AUTH_SECRET_AT_LEAST_32_CHARS
QWEN_AUDIO_AGENT_ALLOW_UNCONFIGURED=1
VOICE_GATEWAY_HOST=127.0.0.1
VOICE_GATEWAY_PORT=3101

# Qwen's sole server-side turn detector. This noisy-room starting profile
# waits through slow pauses and raises the acoustic trigger above its default.
# No browser-side VAD or second submit timer is added.
VOICE_TURN_DETECTION_TYPE=server_vad
VOICE_SILENCE_DURATION_MS=1800
VOICE_VAD_THRESHOLD=0.65
VOICE_AUDIO_INPUT_LABEL=
